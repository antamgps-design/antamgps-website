---
import { Menu, Phone, X } from 'lucide-astro';
import { contact } from '../data/site';

const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'Trang chủ', href: '/', match: '/' },
  { label: 'Giải pháp', href: '/#giai-phap', match: '/giai-phap/' },
  { label: 'Sản phẩm', href: '/san-pham/', match: '/san-pham/' },
  { label: 'Ứng dụng', href: '/iopgps/', match: '/iopgps/' },
  { label: 'Hướng dẫn', href: '/huong-dan/', match: '/huong-dan/' },
  { label: 'Liên hệ', href: '/#lien-he', match: '/lien-he/' },
];

const isActive = (match: string) =>
  match === '/' ? currentPath === '/' : currentPath.startsWith(match);
---

<header class="site-header">
  <div class="container-site header-row">
    <a href="/" class="brand-link" aria-label="Trang chủ An Tâm Smart Solutions">
      <img src="/assets/logo/logo-ngang.png" alt="An Tâm Smart Solutions" class="brand-logo brand-logo-desktop" width="764" height="236" />
      <span class="brand-mobile" aria-hidden="true">
        <img src="/assets/logo/logo-vuong.png" alt="" width="256" height="256" />
        <span><strong>AN TÂM</strong><small>SMART SOLUTIONS</small></span>
      </span>
    </a>
    <nav class="main-nav" aria-label="Điều hướng chính">
      {navItems.map((item) => <a href={item.href} class:list={{ 'is-active': isActive(item.match) }}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="hotline" href={`tel:${contact.hotlineTel}`}><Phone size={17} /> {contact.hotlineDisplay}</a>
      <a class="btn btn-primary" href="/#lien-he">Tư vấn ngay</a>
    </div>
    <button id="menu-open" class="mobile-trigger" aria-label="Mở menu" aria-controls="mobile-menu" aria-expanded="false"><Menu /></button>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <div class="mobile-menu-panel" role="dialog" aria-modal="true" aria-label="Menu điều hướng">
    <div class="mobile-menu-head">
      <img src="/assets/logo/logo-ngang.png" class="brand-logo" alt="An Tâm Smart Solutions" width="764" height="236" />
      <button id="menu-close" class="mobile-trigger" aria-label="Đóng menu"><X /></button>
    </div>
    <nav aria-label="Điều hướng trên điện thoại">
      {navItems.map((item) => <a href={item.href} class:list={{ 'is-active': isActive(item.match) }}>{item.label}</a>)}
    </nav>
    <div class="mobile-menu-actions">
      <a class="btn btn-primary" href={`tel:${contact.hotlineTel}`}><Phone size={18} /> Gọi {contact.hotlineDisplay}</a>
      <a class="btn btn-ghost" href="/tai-xuong/">Tải ứng dụng & tài liệu</a>
    </div>
  </div>
</div>

<script is:inline>
  const menu = document.getElementById('mobile-menu');
  const openButton = document.getElementById('menu-open');
  const closeButton = document.getElementById('menu-close');
  const openMenu = () => {
    menu?.classList.add('open');
    menu?.setAttribute('aria-hidden', 'false');
    openButton?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('menu-open');
    closeButton?.focus();
  };
  const closeMenu = () => {
    menu?.classList.remove('open');
    menu?.setAttribute('aria-hidden', 'true');
    openButton?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
  };
  openButton?.addEventListener('click', openMenu);
  closeButton?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  menu?.addEventListener('click', (event) => { if (event.target === menu) closeMenu(); });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.classList.contains('open')) { closeMenu(); openButton?.focus(); }
  });
</script>
