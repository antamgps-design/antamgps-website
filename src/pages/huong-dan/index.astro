---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactDock from '../../components/ContactDock.astro';
import { appLinks, contact } from '../../data/site';
import { CheckCircle2, Download, ExternalLink, FileText, MessageCircle, Phone, Smartphone, Wrench } from 'lucide-astro';
---

<BaseLayout title="Trung tâm hướng dẫn thiết bị và IOPGPS | An Tâm GPS" description="Hướng dẫn lắp đặt, tải IOPGPS, đăng nhập, sử dụng và nhận hỗ trợ kỹ thuật cho thiết bị định vị An Tâm GPS.">
  <Header />
  <main>
    <section class="subpage-hero subpage-hero-light"><div class="container-site subpage-heading"><span class="eyebrow">TRUNG TÂM HƯỚNG DẪN</span><h1>Cài đặt đúng, sử dụng dễ và được hỗ trợ khi cần.</h1><p>Bắt đầu từ thiết bị, SIM đến tài khoản IOPGPS theo một quy trình rõ ràng.</p></div></section>
    <section class="section"><div class="container-site guide-start-grid"><div><span class="eyebrow eyebrow-green">QUY TRÌNH BÀN GIAO</span><h2 class="h2">Bốn bước để thiết bị sẵn sàng hoạt động.</h2><p class="lead">Không tự đấu dây nếu chưa xác định đúng nguồn điện và chân ACC của phương tiện.</p></div><ol class="numbered-steps numbered-steps-compact"><li><span>01</span><div><b>Kiểm tra thiết bị</b><p>Đối chiếu model, số nhận dạng và phụ kiện đi kèm.</p></div></li><li><span>02</span><div><b>Lắp đặt phù hợp</b><p>Thiết bị có dây cần kỹ thuật viên; thiết bị pin cần vị trí gắn chắc chắn.</p></div></li><li><span>03</span><div><b>Đăng nhập IOPGPS</b><p>Dùng tài khoản đã được An Tâm GPS thiết lập và bàn giao.</p></div></li><li><span>04</span><div><b>Kiểm tra tín hiệu</b><p>Xác nhận vị trí, ACC, nguồn và cảnh báo được hỗ trợ.</p></div></li></ol></div></section>
    <section class="section section-soft"><div class="container-site"><div class="section-intro"><span class="eyebrow">TÀI LIỆU PHỔ BIẾN</span><h2 class="h2">Chọn nội dung bạn cần.</h2></div><div class="guide-card-grid">
      <article class="guide-card"><img src="/assets/docs/h29p-wiring-thumb.webp" alt="Hướng dẫn đấu dây H29P" width="1200" height="1200" loading="lazy" /><div><span class="resource-type">H29P</span><h3>Hướng dẫn đấu dây</h3><p>Sơ đồ kết nối nguồn, ACC và ngõ điều khiển theo cấu hình.</p><a href="/assets/docs/h29p-wiring.png" download><Download size={17} /> Tải ảnh hướng dẫn</a></div></article>
      <article class="guide-card"><img src="/assets/gs12/manual-thumb.webp" alt="Sổ tay hướng dẫn GS12" width="1200" height="1200" loading="lazy" /><div><span class="resource-type">GS12</span><h3>Sổ tay thiết bị</h3><p>Thông tin cơ bản, sơ đồ lắp đặt và lưu ý sử dụng.</p><a href="/assets/gs12/manual.png" download><Download size={17} /> Tải sổ tay</a></div></article>
      <article class="guide-card guide-card-app"><div class="guide-app-icon"><Smartphone size={38} /></div><div><span class="resource-type">IOPGPS</span><h3>Tải và đăng nhập</h3><p>Một mã QR tự mở đúng cửa hàng ứng dụng trên điện thoại.</p><a href={appLinks.smartDownload}><ExternalLink size={17} /> Mở trang tải ứng dụng</a></div></article>
      <article class="guide-card guide-card-support"><div class="guide-app-icon"><Wrench size={38} /></div><div><span class="resource-type">KỸ THUẬT</span><h3>Hỗ trợ theo model</h3><p>Chuẩn bị ảnh tem thiết bị và mô tả tình trạng để được kiểm tra nhanh.</p><a href={contact.zaloUrl} target="_blank" rel="noopener"><MessageCircle size={17} /> Gửi thông tin qua Zalo</a></div></article>
    </div></div></section>
    <section class="section" id="bao-hanh"><div class="container-site support-layout"><div><span class="eyebrow eyebrow-green">BẢO HÀNH & HỖ TRỢ</span><h2 class="h2">Thông tin cần chuẩn bị trước khi liên hệ.</h2><p class="lead">Cung cấp đủ thông tin giúp kỹ thuật viên xác định nhanh lỗi thiết bị, nguồn điện hay kết nối dữ liệu.</p><ul class="support-checklist"><li><CheckCircle2 size={20} /> Tên model và ảnh tem trên thiết bị</li><li><CheckCircle2 size={20} /> Số điện thoại hoặc tài khoản đang sử dụng</li><li><CheckCircle2 size={20} /> Ảnh hoặc video mô tả tình trạng</li><li><CheckCircle2 size={20} /> Thời điểm gần nhất thiết bị còn hoạt động</li></ul></div><div class="warranty-card"><FileText size={31} /><h3>Bảo hành thiết bị 12 tháng</h3><p>Áp dụng theo điều kiện bảo hành của sản phẩm được bàn giao. An Tâm GPS kiểm tra tình trạng trước khi xác nhận phương án xử lý.</p><div class="warranty-actions"><a class="btn btn-primary" href={`tel:${contact.hotlineTel}`}><Phone size={18} /> {contact.hotlineDisplay}</a><a class="btn btn-ghost" href="/tai-xuong/">Tải tài liệu</a></div></div></div></section>
  </main>
  <Footer /><ContactDock />
</BaseLayout>
