---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactDock from '../../components/ContactDock.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, getProduct } from '../../data/products';
import { appLinks, contact } from '../../data/site';
import { CheckCircle2, ChevronRight, Gift, MapPin, MessageCircle, PackageCheck, Phone, ShieldCheck, Smartphone, Wrench } from 'lucide-astro';

export function getStaticPaths() { return products.map((product) => ({ params: { slug: product.slug } })); }
const product = getProduct(Astro.params.slug!)!;
const related = products.filter((item) => item.slug !== product.slug).slice(0, 3);
const isWireless = product.category.toLowerCase().includes('không dây');
const packageItems = [`Thiết bị ${product.name}`, isWireless ? 'Cáp sạc phù hợp' : 'Dây nguồn và phụ kiện theo gói', 'SIM Data 4G đã kích hoạt', 'Tài khoản IOPGPS đã thiết lập', 'Hướng dẫn sử dụng', 'Bảo hành thiết bị 12 tháng'];
const installationSteps = isWireless
  ? [['Kích hoạt', 'Kiểm tra SIM, tài khoản và sạc đủ pin trước khi sử dụng.'], ['Chọn vị trí', 'Gắn thiết bị chắc chắn, kín đáo và tránh nơi che chắn tín hiệu quá mức.'], ['Kiểm tra', 'Xác nhận vị trí, chế độ cập nhật và cảnh báo trên IOPGPS.']]
  : [['Khảo sát vị trí', 'Chọn vị trí kín đáo, phù hợp với nguồn điện và khả năng thu tín hiệu.'], ['Đấu nối', 'Kỹ thuật viên kết nối nguồn, ACC và ngõ điều khiển theo cấu hình.'], ['Cấu hình', 'Kích hoạt SIM, tài khoản IOPGPS và kiểm tra dữ liệu truyền về.'], ['Bàn giao', 'Hướng dẫn xem vị trí, lịch sử, cảnh báo và cách liên hệ hỗ trợ.']];
const faqs = [
  { question: `${product.name} có sử dụng IOPGPS không?`, answer: `Có. Thiết bị ${product.name} do An Tâm GPS cung cấp được thiết lập để quản lý trên IOPGPS, tùy theo cấu hình của từng phiên bản.` },
  { question: 'Gói tặng kèm 12 tháng gồm những gì?', answer: 'Gồm SIM Data 4G và quyền sử dụng IOPGPS trong 12 tháng đầu, được kích hoạt trước khi bàn giao.' },
  { question: 'Từ năm thứ hai có phát sinh phí không?', answer: 'Có. Phí duy trì SIM và nền tảng được áp dụng theo chính sách tại thời điểm gia hạn; An Tâm GPS sẽ thông báo trước khi gia hạn.' },
  { question: isWireless ? 'Tôi có thể tự lắp thiết bị không?' : 'Tôi có nên tự đấu dây thiết bị không?', answer: isWireless ? 'Thiết bị không dây dễ lắp hơn, nhưng vẫn cần chọn vị trí an toàn và kiểm tra tín hiệu sau khi gắn.' : 'Thiết bị có dây nên được lắp bởi kỹ thuật viên để xác định đúng nguồn, ACC và tránh ảnh hưởng hệ thống điện của xe.' },
];
---

<BaseLayout title={`${product.name} — ${product.subtitle} | An Tâm GPS`} description={product.description}>
  <Header />
  <main>
    <section class="product-hero product-detail-hero"><div class="container-site">
      <nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><ChevronRight size={15} /><a href="/san-pham/">Sản phẩm</a><ChevronRight size={15} /><span>{product.name}</span></nav>
      <div class="product-hero-grid"><div><span class="eyebrow">{product.category} · {product.badge}</span><h1>{product.name}</h1><h2>{product.subtitle}</h2><p class="lead">{product.description}</p><div class="highlight-list">{product.highlights.map((item) => <div class="highlight"><CheckCircle2 size={20} color="#16852b" /><span>{item}</span></div>)}</div><div class="hero-actions product-hero-actions"><a class="btn btn-green" href={`tel:${contact.hotlineTel}`}><Phone size={18} /> Nhận tư vấn</a><a class="btn btn-ghost" href={contact.zaloUrl} target="_blank" rel="noopener"><MessageCircle size={18} /> Hỏi qua Zalo</a></div></div><div class="product-showcase"><img src={product.image} alt={`${product.name} - ${product.subtitle}`} fetchpriority="high" /></div></div>
    </div></section>
    <section class="product-fit-strip"><div class="container-site product-fit-inner"><b>Phù hợp với:</b><div class="application-chips">{product.applications.map((item) => <span>{item}</span>)}</div></div></section>
    <section class="section"><div class="container-site"><div class="section-intro"><span class="eyebrow">TÍNH NĂNG NỔI BẬT</span><h2 class="h2">Quản lý phương tiện dễ dàng và an toàn hơn.</h2></div><div class="feature-grid product-feature-grid">{product.features.map((feature, index) => { const icons = [MapPin, ShieldCheck, Smartphone, Wrench]; const Icon = icons[index % icons.length]; return <article class="card feature-card"><div class="icon-box"><Icon size={27} /></div><h3>{feature.title}</h3><p>{feature.description}</p></article>; })}</div></div></section>
    <section class="section section-soft"><div class="container-site product-service-grid"><div class="package-panel"><span class="eyebrow eyebrow-green">BỘ SẢN PHẨM</span><h2 class="h2">Những gì khách hàng nhận được.</h2><ul class="package-list">{packageItems.map((item) => <li><PackageCheck size={21} /><span>{item}</span></li>)}</ul></div><div class="installation-panel"><span class="eyebrow">LẮP ĐẶT & BÀN GIAO</span><ol class="numbered-steps numbered-steps-compact">{installationSteps.map(([title, description], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><b>{title}</b><p>{description}</p></div></li>)}</ol></div></div></section>
    <section class="section" id="thong-so"><div class="container-site specs-layout"><div><span class="eyebrow">THÔNG SỐ KỸ THUẬT</span><h2 class="h2">Thông tin rõ ràng, dễ đối chiếu.</h2><p class="lead">Thông số áp dụng theo phiên bản sản phẩm do An Tâm GPS cung cấp và được xác nhận khi tư vấn.</p></div><div class="spec-grid">{product.specs.map((spec) => <div class="spec-row"><span>{spec.label}</span><b>{spec.value}</b></div>)}</div></div></section>
    {product.gallery.length > 0 && <section class="section section-soft"><div class="container-site"><span class="eyebrow">HÌNH ẢNH & TÀI LIỆU</span><h2 class="h2">Thông tin sản phẩm chi tiết.</h2><div class="gallery-grid">{product.gallery.map((image, index) => <figure><img src={image} alt={`${product.name} - hình thông tin ${index + 1}`} loading="lazy" decoding="async" /><figcaption>{product.name} — thông tin sản phẩm {index + 1}</figcaption></figure>)}</div></div></section>}
    <section class="section"><div class="container-site product-support-grid"><div><span class="eyebrow eyebrow-green">DỊCH VỤ ĐI KÈM</span><h2 class="h2">Chi phí được nói rõ ngay từ đầu.</h2><p class="lead">Thiết bị được bàn giao cùng SIM và tài khoản đã thiết lập để khách hàng không phải tự ghép nhiều dịch vụ rời rạc.</p><div class="fee-notice"><Gift size={25} /><div><b>Tặng kèm 12 tháng đầu</b><p>SIM Data 4G và quyền sử dụng IOPGPS. Từ năm thứ hai áp dụng phí duy trì theo chính sách tại thời điểm gia hạn.</p></div></div></div><div class="faq-list">{faqs.map((item, index) => <details open={index === 0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}<a class="text-link inline-arrow" href={appLinks.smartDownload}>Tải ứng dụng IOPGPS →</a></div></div></section>
    <section class="section section-soft"><div class="container-site"><div class="section-head"><div><span class="eyebrow">SẢN PHẨM LIÊN QUAN</span><h2 class="h2 section-title-no-margin">Tham khảo thêm thiết bị khác.</h2></div><a class="text-link" href="/san-pham/">Xem tất cả →</a></div><div class="product-grid related-grid">{related.map((item) => <ProductCard product={item} />)}</div></div></section>
  </main>
  <Footer /><ContactDock />
</BaseLayout>
